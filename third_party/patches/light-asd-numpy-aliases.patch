# Light-ASD: replace numpy aliases removed in numpy >= 1.24
#
# Upstream repo:   https://github.com/Junhua-Liao/Light-ASD
# Applies to:      ed38c232de5efe0261dbd68627c0ade7cdfe14eb
#
# WHY THIS EXISTS
# ---------------
# `np.int` and `np.float` were deprecated in numpy 1.20 and REMOVED in 1.24. A clean
# clone of Light-ASD therefore crashes at active-speaker detection with:
#     AttributeError: module 'numpy' has no attribute 'int'
# under any modern numpy (this project runs 2.x).
#
# The recorded patch makes the pinned upstream revision compatible with the validated
# NumPy runtime and keeps the third-party source state reproducible.
#
# The substitution is behaviour-preserving: `np.int` was only ever an alias for the
# Python builtin `int`, and `np.float` for `float`.
#
# Apply with:  git -C third_party/Light-ASD apply ../patches/light-asd-numpy-aliases.patch

--- a/model/faceDetector/s3fd/box_utils.py
+++ b/model/faceDetector/s3fd/box_utils.py
@@ -35,7 +35,7 @@
         inds = np.where(ovr <= thresh)[0]
         order = order[inds + 1]

-    return np.array(keep).astype(np.int)
+    return np.array(keep).astype(int)


--- a/utils/get_ava_active_speaker_performance.py
+++ b/utils/get_ava_active_speaker_performance.py
@@ -41,7 +41,7 @@
   if not isinstance(precision, np.ndarray) or not isinstance(
       recall, np.ndarray):
     raise ValueError("precision and recall must be numpy array")
-  if precision.dtype != np.float or recall.dtype != np.float:
+  if precision.dtype != float or recall.dtype != float:
     raise ValueError("input must be float numpy array.")
