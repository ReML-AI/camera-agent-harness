{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-harness.local/schemas/v1/best_angle.schema.json",
  "title": "Per-segment best-angle and frame-gate artifact",
  "x-definition-ids": ["CONTRACT-04-BEST-ANGLE-GATE"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "segments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"$ref": "#/$defs/id"},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_id", "track_id", "mean_asd", "eligible_frame_count", "reason"],
      "properties": {
        "camera_id": {"$ref": "#/$defs/id"}, "track_id": {"type": ["string", "null"]},
        "mean_asd": {"type": ["number", "null"]}, "eligible_frame_count": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_index", "aligned_timestamp_seconds", "asd_score", "emitted", "reason"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "aligned_timestamp_seconds": {"type": "number", "minimum": 0},
        "asd_score": {"type": ["number", "null"]},
        "emitted": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript_segment_id", "speaker_id", "start_seconds", "end_seconds", "camera_scores", "selected_camera_id", "selected_track_id", "frame_gate"],
      "properties": {
        "transcript_segment_id": {"$ref": "#/$defs/id"}, "speaker_id": {"$ref": "#/$defs/id"},
        "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "camera_scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/score"}},
        "selected_camera_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "selected_track_id": {"type": ["string", "null"]},
        "frame_gate": {"type": "array", "items": {"$ref": "#/$defs/sample"}}
      }
    }
  }
}
