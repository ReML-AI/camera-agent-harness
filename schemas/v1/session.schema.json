{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-harness.local/schemas/v1/session.schema.json",
  "title": "Canonical session and synchronized stream manifest",
  "x-definition-ids": ["CONTRACT-01-TIME", "CONTRACT-02-IDENTITY"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "session_origin", "session_end_seconds", "streams"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"$ref": "#/$defs/id"},
    "session_origin": {"type": "string", "format": "date-time"},
    "session_end_seconds": {"type": "number", "exclusiveMinimum": 0},
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stream"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "kind", "time_base", "fps", "duration_seconds", "sync_transform", "source_sha256"],
      "properties": {
        "stream_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["room_video", "monitor_video", "room_audio"]},
        "time_base": {"$ref": "#/$defs/rational"},
        "fps": {"oneOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "sync_transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transform_id", "version", "offset_seconds", "drift"],
          "properties": {
            "transform_id": {"$ref": "#/$defs/id"},
            "version": {"const": "1.0.0"},
            "offset_seconds": {"type": "number"},
            "drift": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
