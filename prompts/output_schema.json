{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["moments"],
  "properties": {
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moment_id", "start_seconds", "end_seconds", "description", "clinical_significance", "category", "evidence_ids", "cross_modal_observations"],
        "properties": {
          "moment_id": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "description": {"type": "string", "minLength": 1},
          "clinical_significance": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1, "description": "Validated at runtime against the configured seven-category taxonomy."},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "cross_modal_observations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
